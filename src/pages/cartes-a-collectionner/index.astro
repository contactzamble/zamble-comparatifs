---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProductCard from "../../components/ProductCard.astro";
import { getCollection } from "astro:content";

const produits = await getCollection("produits", (p) => p.data.categorie === "cartes-a-collectionner");
---
<BaseLayout
  title="Cartes à collectionner — Suivi de prix"
  description="Prix actuel, historique et alertes sur notre sélection de cartes à collectionner (Pokémon, Magic, One Piece, Yu-Gi-Oh)."
>
  <h1>Cartes à collectionner</h1>
  <p class="lede">Pokémon, Magic: The Gathering, One Piece Card Game, Yu-Gi-Oh — suivi de prix et alerte dès que ça baisse.</p>

  {produits.length === 0 ? (
    <p class="lede">Nos premières fiches de cartes à collectionner arrivent bientôt.</p>
  ) : (
    <div class="grid">
      {produits.map((produit) => <ProductCard produit={produit} />)}
    </div>
  )}
</BaseLayout>
