---
import BaseLayout from "../../layouts/BaseLayout.astro";
---
<BaseLayout title="Connexion | Zamble" description="Connectez-vous à votre compte Zamble.">
  <h1>Connexion</h1>

  <form id="login-form" style="display:flex; flex-direction:column; gap:1rem; margin-top:1.5rem; max-width:24rem">
    <label>
      Email
      <input id="email" type="email" name="email" required autocomplete="email" style="width:100%; padding:0.5rem; margin-top:0.25rem" />
    </label>
    <label>
      Mot de passe
      <input id="password" type="password" name="password" required autocomplete="current-password" style="width:100%; padding:0.5rem; margin-top:0.25rem" />
    </label>
    <button type="submit" class="btn btn-primary">Se connecter</button>
  </form>

  <div id="login-status" style="margin-top:1rem; color:var(--text-muted)"></div>

  <p style="margin-top:1.5rem">
    <a href="/compte/mot-de-passe-oublie/">Mot de passe oublié ?</a><br />
    Pas encore de compte ? <a href="/compte/inscription/">Créer un compte</a>
  </p>
</BaseLayout>

<script type="module">
  import { supabase } from "../../lib/supabase";

  const form = document.getElementById("login-form");
  const status = document.getElementById("login-status");

  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    const email = document.getElementById("email").value.trim();
    const password = document.getElementById("password").value;
    status.textContent = "Connexion...";

    const { error } = await supabase.auth.signInWithPassword({ email, password });
    if (error) {
      status.textContent = `Erreur : ${error.message}`;
      return;
    }
    window.location.href = "/compte/";
  });
</script>
