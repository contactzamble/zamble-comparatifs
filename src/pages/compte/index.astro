---
import BaseLayout from "../../layouts/BaseLayout.astro";
---
<BaseLayout title="Mon compte | Zamble" description="Gérez vos alertes de prix et vos préférences de notification.">
  <div id="loading">Chargement...</div>

  <div id="dashboard" hidden>
    <h1>Mon compte</h1>
    <p class="lede" id="account-email"></p>

    <h2>Préférences de notification</h2>
    <label style="display:flex; align-items:center; gap:0.5rem; margin-top:0.75rem">
      <input id="email-enabled" type="checkbox" />
      Recevoir les alertes par email
    </label>

    <div style="margin-top:1rem">
      <p id="telegram-status" class="meta" style="color:var(--text-muted)"></p>
      <button id="telegram-link-btn" class="btn btn-secondary" style="margin-top:0.5rem">Lier Telegram</button>
    </div>

    <h2>Prix suivis</h2>
    <p id="tracked-empty" class="lede" hidden>Vous ne suivez aucun prix pour l'instant. Repérez un produit et cliquez sur « Suivre le prix ».</p>
    <ul id="tracked-list" style="list-style:none; padding:0; display:flex; flex-direction:column; gap:0.75rem; margin-top:1rem"></ul>

    <button id="logout-btn" class="btn btn-secondary" style="margin-top:2rem">Se déconnecter</button>
  </div>
</BaseLayout>

<script type="module">
  import { supabase } from "../../lib/supabase";

  const loading = document.getElementById("loading");
  const dashboard = document.getElementById("dashboard");
  const emailEl = document.getElementById("account-email");
  const emailEnabled = document.getElementById("email-enabled");
  const telegramStatus = document.getElementById("telegram-status");
  const telegramLinkBtn = document.getElementById("telegram-link-btn");
  const trackedEmpty = document.getElementById("tracked-empty");
  const trackedList = document.getElementById("tracked-list");
  const logoutBtn = document.getElementById("logout-btn");

  const {
    data: { session },
  } = await supabase.auth.getSession();

  if (!session) {
    window.location.href = "/compte/connexion/";
  } else {
    const user = session.user;
    emailEl.textContent = `Connecté en tant que ${user.email}`;

    const { data: prefs } = await supabase
      .from("notification_preferences")
      .select("email_enabled, telegram_enabled, telegram_chat_id")
      .eq("user_id", user.id)
      .single();
    emailEnabled.checked = prefs?.email_enabled ?? true;

    emailEnabled.addEventListener("change", async () => {
      await supabase.from("notification_preferences").update({ email_enabled: emailEnabled.checked }).eq("user_id", user.id);
    });

    if (prefs?.telegram_enabled && prefs?.telegram_chat_id) {
      telegramStatus.textContent = "✅ Telegram lié — vous recevrez vos alertes sur Telegram.";
      telegramLinkBtn.textContent = "Relier un autre compte Telegram";
    } else {
      telegramStatus.textContent = "Telegram non lié.";
    }

    telegramLinkBtn.addEventListener("click", async () => {
      const { data: token, error } = await supabase.rpc("request_telegram_link");
      if (error || !token) {
        telegramStatus.textContent = "Erreur lors de la génération du lien, réessayez.";
        return;
      }
      window.open(`https://t.me/ZambleAlertesBot?start=${token}`, "_blank");
    });

    const { data: tracked } = await supabase
      .from("tracked_items")
      .select("id, target_price, trackable_items(slug, source, last_price)")
      .eq("user_id", user.id)
      .eq("is_active", true);

    if (!tracked || tracked.length === 0) {
      trackedEmpty.hidden = false;
    } else {
      for (const t of tracked) {
        const item = t.trackable_items;
        const li = document.createElement("li");
        li.style.cssText =
          "display:flex; justify-content:space-between; align-items:center; border:1px solid var(--border); border-radius:var(--radius); padding:0.75rem 1rem";

        const label = document.createElement("span");
        const name = item.slug.replace(/-/g, " ");
        label.textContent = `${name} — ${item.last_price.toFixed(2)} €`;

        const removeBtn = document.createElement("button");
        removeBtn.className = "btn btn-secondary";
        removeBtn.textContent = "Ne plus suivre";
        removeBtn.addEventListener("click", async () => {
          await supabase.from("tracked_items").delete().eq("id", t.id);
          li.remove();
          if (trackedList.children.length === 0) trackedEmpty.hidden = false;
        });

        li.append(label, removeBtn);
        trackedList.appendChild(li);
      }
    }

    logoutBtn.addEventListener("click", async () => {
      await supabase.auth.signOut();
      window.location.href = "/compte/connexion/";
    });

    loading.hidden = true;
    dashboard.hidden = false;
  }
</script>
