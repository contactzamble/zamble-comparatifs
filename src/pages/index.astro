---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProductCard from "../components/ProductCard.astro";
import { getCollection } from "astro:content";

const produits = (await getCollection("produits")).slice(0, 3);
---
<BaseLayout
  title="Zamble Comparatifs — LEGO, jeux de société, cartes à collectionner"
  description="Comparatifs indépendants et suivi de prix pour bien choisir vos jeux et jouets."
>
  <h1>Bien choisir vos jeux et jouets</h1>
  <p class="lede">
    Des comparatifs indépendants et un suivi de prix pour s'y retrouver parmi les sets LEGO,
    les jeux de société et les cartes à collectionner : budget, points forts et limites de
    chaque produit, avec une alerte quand le prix baisse.
  </p>

  <h2>À la une</h2>
  <div class="grid">
    {produits.map((produit) => <ProductCard produit={produit} />)}
  </div>

  <p style="margin-top:2.5rem"><a class="btn btn-secondary" href="/lego/">Voir tous les comparatifs LEGO →</a></p>
</BaseLayout>
