---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProductCard from "../../components/ProductCard.astro";
import { getCollection } from "astro:content";

const produits = await getCollection("produits", (p) => p.data.categorie === "lego");
---
<BaseLayout
  title="LEGO — Suivi de prix"
  description="Prix actuel, historique et alertes sur notre sélection de sets LEGO."
>
  <h1>LEGO</h1>
  <p class="lede">Notre sélection de sets LEGO, avec suivi de prix et alerte dès qu'il baisse.</p>

  <h2>Nos guides d'achat</h2>
  <ul>
    <li><a href="/lego/meilleurs-sets-2026/">Meilleurs sets LEGO Star Wars 2026</a></li>
    <li><a href="/lego/enfant-vs-collectionneur/">LEGO Star Wars : enfant ou collectionneur, comment choisir ?</a></li>
    <li><a href="/lego/sous-300-euros/">Les meilleurs sets LEGO Star Wars sous 300 €</a></li>
  </ul>

  <h2>Tous les sets</h2>
  <div class="grid">
    {produits.map((produit) => <ProductCard produit={produit} />)}
  </div>
</BaseLayout>
